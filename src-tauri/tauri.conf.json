{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Switch Lite",
  "version": "0.1.0-alpha.1",
  "identifier": "org.cc-switch.lite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC Switch Lite",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
